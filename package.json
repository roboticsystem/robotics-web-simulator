{
  "name": "robot-script-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix sensor-backend run dev",
    "build": "vite build",
    "preview": "vite preview",
    "build:picoc": "powershell -ExecutionPolicy Bypass -File ./scripts/build-picoc.ps1",
