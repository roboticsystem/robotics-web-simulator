  "dependencies": {
    "echarts": "^5.6.0",
    "monaco-editor": "^0.52.2",
    "pinia": "^2.3.1",
    "three": "^0.179.1",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^5.4.19"
  }
}
